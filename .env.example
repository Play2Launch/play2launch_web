# No real API requests by default. Preview data is explicitly labeled.
VITE_API_MODE=demo
# For local live authentication: VITE_API_MODE=live.
# Complete API prefix (including /api/v1), e.g. http://127.0.0.1:8088/api/v1.
# Or use npm run dev:live. Never put server secrets in VITE_* variables.
VITE_API_BASE_URL=
VITE_TELEGRAM_BOT_USERNAME=
VITE_TELEGRAM_APP_NAME=
# Public Reown Project ID; configure allowed origins in Reown dashboard.
VITE_WALLETCONNECT_PROJECT_ID=
# mainnet (4663) or testnet (46630). Must match the server IDO chain binding.
VITE_WALLET_NETWORK=mainnet
