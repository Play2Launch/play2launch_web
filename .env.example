# No real API requests by default. Preview data is explicitly labeled.
VITE_API_MODE=demo
# For local live authentication: VITE_API_MODE=live.
# Complete API prefix (including /api/v1), e.g. http://127.0.0.1:8088/api/v1.
# Or use npm run dev:live. Never put server secrets in VITE_* variables.
VITE_API_BASE_URL=
# Telegram and wallet settings are in server conf/config.yml under player.
