{
  "name": "play-to-launch-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "@coinbase/cdp-sdk": {
      "axios": "1.20.0"
    }
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:live": "vite --host 0.0.0.0 --mode live",
    "build": "tsc -b && vite build",
    "build:live": "tsc -b && vite build --mode live",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run"
  },
  "dependencies": {
    "@relayprotocol/relay-sdk": "^8.0.4",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-ethers": "^1.8.23",
    "ethers": "^6.17.0",
    "firebase": "^13.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.7"
  }
}
